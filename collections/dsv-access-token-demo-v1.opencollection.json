{
  "opencollection": "1.0.0",
  "info": {
    "name": "Access Token (DEMO)",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DSV-Subscription-Key",
      "value": "{{DSV-Subscription-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch DSV Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dsv.com/my-demo/oauth/v1/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "grant_type",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "client_secret",
                  "value": ""
                },
                {
                  "name": "scope",
                  "value": ""
                },
                {
                  "name": "refresh_token",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Fetch myDSV Access Token (DEMO)"
        }
      ]
    }
  ],
  "bundled": true
}