              {
                "name": "bookingId",
                "value": "",
                "type": "path"
              },
              {
                "name": "sscc",
                "value": "",
                "type": "path"
              },
              {
                "name": "labelType",
                "value": "",
                "type": "query"
              },
              {
                "name": "printFormat",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Generate labels for given bookingId and SSCC."
        },
        {
          "info": {
            "name": "7. Submit bulk bookings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.dsv.com/my-demo/booking/v2/bookings/bulk",
            "headers": [
              {
