{
  "opencollection": "1.0.0",
  "info": {
    "name": "BOOKING (DEMO) - Air, Sea, Road (EU), Rail",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "DSV-Subscription-Key",
      "value": "{{DSV-Subscription-Key}}",
      "placement": "header"
