          "docs": "Create new Product Data records with full product information via API"
        },
        {
          "info": {
            "name": "Update Product Data record(s)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.dsv.com/cl-demo/productdata/v1/productData",
            "headers": [
              {
                "name": "api-version",
                "value": "1"
              },
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Request used to update previously created product data records."
        }
      ]
